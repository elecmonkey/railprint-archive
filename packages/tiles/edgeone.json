{
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://rail.elecmonkey.com"
        }
      ]
    },
    {
      "source": "/*.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/tiles.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
